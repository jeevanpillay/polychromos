# Convex Backend
# Local development: http://127.0.0.1:3210
# Production: Your Convex deployment URL
VITE_CONVEX_URL=https://your-project.convex.cloud

# Application URL
# Local: http://localhost:3001
# Production: Your Vercel deployment URL
VITE_APP_URL=http://localhost:3001

# Clerk Authentication
# Get your keys from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_...

# Sentry Error Tracking (Optional)
# Get your DSN from https://sentry.io/settings/projects/
VITE_SENTRY_DSN=https://...@sentry.io/...
SENTRY_DSN=https://...@sentry.io/...

# Vercel Environment (Automatically set by Vercel)
# Values: development, preview, production
# VERCEL_ENV=development
# VITE_VERCEL_ENV=development

# E2E Testing (Optional - for automated tests only)
# E2E_CLERK_USER_EMAIL=test@example.com
# E2E_CLERK_USER_PASSWORD=your-test-password

# Source Map Upload (Optional - for production builds)
# Generate at: https://sentry.io/settings/account/api/auth-tokens/
# SENTRY_AUTH_TOKEN=your-sentry-auth-token
